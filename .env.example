# Keep this key on your server only. Never paste it into the Android app.
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
# Recommended for public deployments. Set the same value in Screen AI's shared-token field.
SCREEN_AI_SHARED_TOKEN=replace_with_a_long_random_token
PORT=3000
